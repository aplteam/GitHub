 r←Run(Cmd Args);parms;list;ind
 r←0 0⍴''
 :Select ⎕C Cmd
 :Case ⎕C'ListRepos'
     parms←⎕NS''
     parms.permanent←Args.Switch'permanent'
     parms.verbose←Args.Switch'verbose'
     parms.issues←0 Args.Switch'issues'
     parms.sort←''Args.Switch'sort'
     parms.forks←0 Args.Switch'forks'
     parms.owner←''Args.Switch'_1'
     :If parms.permanent
         'You must specify an owner with -permanent'Assert 0<≢parms.owner
     :ElseIf 0=≢parms.owner
         parms.owner←GetDefaultOwner
     :EndIf
     parms.accessToken←GetAccessToken
     r←ListRepos parms
     :If parms.permanent
         SaveDefaultOwner parms.owner
     :EndIf
 :Case ⎕C'ListIssues'
     parms←⎕NS''
     parms.permanent←Args.Switch'permanent'
     parms.owner←''Args.Switch'_1'
     parms.repo←''Args.Switch'_2'
     parms.accessToken←GetAccessToken
     :If '/'∊parms.owner
         parms.(owner repo)←2↑('/'(≠⊆⊢)parms.owner),⊂''
     :ElseIf 0=≢parms.repo
         parms.repo←parms.owner
         parms.owner←''
     :EndIf
     :If 0=≢parms.owner
         parms.owner←GetDefaultOwner
     :EndIf
     :If parms.permanent
         'You must specify an owner with -permanent'Assert 0<≢parms.owner
     :EndIf
     parms.verbose←Args.Switch'verbose'
     parms.html←Args.Switch'html'
     parms.filename←''Args.Switch'filename'
     parms.collapse←Args.Switch'collapse'
     :If 0<≢parms.assignees←''Args.Switch'assignees'
     :AndIf ~parms.html
         parms.verbose←1
     :EndIf
     r←ListIssues parms
     :If parms.permanent
         SaveDefaultOwner parms.owner
     :EndIf
 :Case ⎕C'GoToGitHub'
     parms←⎕NS''
     parms.permanent←Args.Switch'permanent'
     parms.owner←''Args.Switch'_1'
     parms.repo←''Args.Switch'_2'
     :If '/'∊parms.owner
         parms.(owner repo)←{⍵{((⍵-1)↑⍺)(⍵↓⍺)}⍵⍳'/'}parms.owner
     :ElseIf 0=≢parms.repo
         parms.repo←parms.owner
         parms.owner←''
         :If 0=≢parms.repo
         :AndIf 9=⎕SE.⎕NC'Cider'
             list←{⍵[;1]}⎕SE.Cider.ListOpenProjects 0
             :If 1=≢list
                 parms.(owner repo)←¯2↑'/'(≠⊆⊢)(⍎⊃list).CiderConfig.CIDER.project_url
             :ElseIf 1<≢list
                 parms.owner←⊃¯2↑'/'(≠⊆⊢)(⍎1⊃list).CiderConfig.CIDER.project_url
                 list←{⊃¯1↑'.'(≠⊆⊢)⍵}¨list
                 list,←⊂parms.owner,'''s home page on GitHub'
                 ind←'SelGo2GitHub_2@Select repository to go to on GitHub:' 0 1 1 CommTools.Select list
                 :If ¯1≡ind
                     r←'Cancelled by user' ⋄ →0
                 :ElseIf ind=≢list
                     parms.repo←''          ⍝ The owner's home page on GitHub
                 :Else
                     parms.repo←ind⊃list
                 :EndIf
             :EndIf
         :EndIf
     :EndIf
     :If 0=≢parms.owner
         parms.owner←GetDefaultOwner
     :EndIf
     :If parms.permanent
         'You must specify an owner with -permanent'Assert 0<≢parms.owner
     :EndIf
     GoToGitHub parms.(owner repo)
     :If parms.permanent
         SaveDefaultOwner parms.owner
     :EndIf
 :Case ⎕C'ReportAllIssues'
     parms←⎕NS''
     parms.owner←''Args.Switch'_1'
     :If 0=≢parms.owner
         parms.owner←GetDefaultOwner
     :EndIf
     parms.assignees←''Args.Switch'assignees'
     parms.accessToken←GetAccessToken
     parms.filename←''Args.Switch'filename'
     :If 0=≢parms.filename
         parms.filename←'.html'FilesAndDirs.GetTempFilename2'ReportIssues'
     :EndIf
     parms.raw←0 Args.Switch'raw'
     r←ReportAllIssues parms
 :Case ⎕C'CreateRelease'
     parms←CreateRelease ⍬
     :If Args.Switch'raw'
         r←parms
     :Else
         :If 0<≢parms.assets
             ⍝ Everything in the distribution folder was collected, so ask which of it
             ⍝ is to be attached. Selecting none is a perfectly good answer.
             ind←'SelReleaseAssets@Select the files to attach to the release:' 1 0 1 CommTools.Select parms.assets
             :If ¯1≡ind
                 r←'Cancelled by user' ⋄ →0
             :EndIf
             parms.assets←parms.assets[,ind]   ⍝ "," so that one file stays a vector
         :EndIf
         ⍝ Prints it. Its shy result must NOT be returned, or the user command
         ⍝ framework would put the very same command on display a second time.
         PrintReleaseCommand parms
     :EndIf
 :Case ⎕C'Version'
     r←↑('GitHub'Version)('GitHubAPIv3'GitHubAPIv3.Version)
 :Else
     ∘∘∘ ⍝ Huh?!
 :EndSelect
