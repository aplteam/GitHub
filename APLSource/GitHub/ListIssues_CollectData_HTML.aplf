 r←i ListIssues_CollectData_HTML list;isNull
⍝ ⍺ is an index namespace for "list"
 r←↑list.(number title labels user.login body created_at comments assignees updated_at html_url)
 i.(number title labels user body created_at comments assignees updated_at html_url)←⍳10
 r[;i.labels]←{0=≢⍵:⍵ ⋄ ⊃{⍺,',',⍵}/⍵.name}¨r[;i.labels]         ⍝ Convert lables
 isNull←(⊂' null ')≡¨⍕¨list.body
 :If ∨/isNull
     r[⍸isNull;i.body]←⊂''                                      ⍝ Convert NULL to ''
 :EndIf
 r[;i.assignees]←{0=≢⍵:'' ⋄ 1=≢⍵:⊃⍵.login ⋄ ⊃{⍺,',',⍵}/⍵.login}¨r[;i.assignees]  ⍝ Convert to just the name
 r[;i.created_at]←{⍵[(⍳10)]}¨r[;i.created_at]                   ⍝ Convert the date to YYYY-MM-DD
 r[;i.updated_at]←{⍵[(⍳10)]}¨r[;i.updated_at]                   ⍝ Convert the date to YYYY-MM-DD
 r[;i.body]←{(⎕UCS 13)@(⍸⍵=⎕UCS 10)⊣⍵}¨r[;i.body]               ⍝ Convert LF to CR
 r[;i.body]←r[;i.body]~⎕UCS 10                                  ⍝ Remove LF
 r[;i.body]←{(⎕UCS 13)APLTreeUtils2.Split ⍵}¨r[;i.body]         ⍝ Split at CRs
⍝Done
